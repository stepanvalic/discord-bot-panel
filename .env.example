# Discord Bot Panel - Environment Variables

# Panel Settings
PANEL_HOST=0.0.0.0
PANEL_PORT=8000
PANEL_DEBUG=false

# Database Settings
# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///data.db

# Discord Bot Settings
# Token for the Discord bot used to fetch avatars
DISCORD_BOT_TOKEN=

# Avatar Update Settings
# Interval in minutes between avatar updates (default: 60)
AVATAR_UPDATE_INTERVAL=60

# Webhook Settings
# Discord webhook URL for status updates
WEBHOOK_URL=
# Secret key for webhook authentication
WEBHOOK_KEY=

# Security Settings
# Secret key for session encryption
SECRET_KEY=

# Logging Settings
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Maximum log file size in MB
MAX_LOG_SIZE=10
# Number of log files to keep
MAX_LOG_FILES=5
